[TEMPLATE]
# Public browser-safe configuration only.
# Local development: the browser calls the API directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production with a separately deployed API (recommended).
# The browser calls this Next.js deployment and `/api/v1/*` is proxied to the
# API, so authentication cookies stay first-party. Browsers block the API's
# cookies as third-party cookies when the two deployments are on different
# sites, which makes a successful login lose its session immediately.
# API_PROXY_TARGET is server-side only; never prefix it with NEXT_PUBLIC_.
# NEXT_PUBLIC_API_URL=/api/v1
# API_PROXY_TARGET=https://hospitalos-api.vercel.app

# Production with direct API calls: only works when the frontend and API share
# one parent domain (for example app.example.com and api.example.com).
# NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
